#!/usr/bin/env bash
# Usage: bin/make-poster --images <folder> [options]
# See `remotion-poster/scripts/make-poster.mjs` for the full flag list.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
exec node "$ROOT/remotion-poster/scripts/make-poster.mjs" "$@"
